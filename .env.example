APP_NAME="SINTA Citation Finder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# Untuk MySQL, ganti DB_CONNECTION=mysql dan isi konfigurasi di bawah.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sinta_citation_finder
# DB_USERNAME=root
# DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Corpus sync (optional)
SINTA_BASE_URL=https://sinta.kemdiktisaintek.go.id
SINTA_CRAWL_DELAY_MS=1200
SINTA_HTTP_TIMEOUT=20
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=
CROSSREF_USER_AGENT="SintaCitationFinder/1.1 (Laravel; academic portfolio project)"
CROSSREF_HTTP_TIMEOUT=25
CROSSREF_DELAY_MS=250
